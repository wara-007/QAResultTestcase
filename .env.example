NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_SITE_URL=https://your-site.netlify.app
SUPABASE_SECRET_KEY=sb_secret_...
PROJECT_ADMIN_SECRET=change-this-admin-code

# Legacy central SMTP only (not used by the QA Gmail OAuth approval flow)
GMAIL_USER=qatrueapp@gmail.com
GMAIL_APP_PASSWORD=

# Google Sheets service account (server-side only; never add NEXT_PUBLIC_)
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Google OAuth for QA evidence uploads (server-side only)
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_OAUTH_COOKIE_SECRET=

# Google Picker: public browser API key restricted to your app's websites.
# Use the same Cloud project as GOOGLE_OAUTH_CLIENT_ID; not the project ID/name.
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=

# Optional: large-file storage. Keep these server-side only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=https://pub-your-bucket-id.r2.dev

# Microsoft 365 delegated mail for QA @truecorp.co.th (server-side only).
# Register a Web application in the company's Entra tenant; see docs/qa-mail-setup.md.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Stable random secret, minimum 32 characters. Keep it separate from public env vars.
MAIL_TOKEN_ENCRYPTION_SECRET=
